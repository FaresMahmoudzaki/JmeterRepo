          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def list = [&quot;true&quot; , &quot;false&quot;]
def re =list[new Random().nextInt(list.size())]
vars.put(&quot;vpnValue&quot; , re) ;</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def vpnList = [&apos;vpn1&apos;, &apos;vpn2&apos;, &apos;vpn3&apos;, &apos;vpn4&apos;, &apos;vpn5&apos;]
def randomVpn = vpnList[new Random().nextInt(vpnList.size())]
vars.put(&apos;vpnValue1&apos;, randomVpn)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - getCountryName&amp;&amp;Code" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.Locale

def countryMap = [:]

// loop على كل الدول
for (code in Locale.getISOCountries()) {
    def locale = new Locale(&quot;&quot;, code)
    def countryName = locale.getDisplayCountry(Locale.ENGLISH)
    def iso3 = locale.getISO3Country()
    
    countryMap[countryName] = [
        iso2: code,
        iso3: iso3
    ]
}

// random country
def countries = countryMap.keySet().toList()
def randomCountry = countries[new Random().nextInt(countries.size())]

// get iso2 &amp; iso3
def iso2 = countryMap[randomCountry].iso2
def iso3 = countryMap[randomCountry].iso3

// save in JMeter vars
vars.put(&apos;country&apos;, randomCountry)
vars.put(&apos;iso2&apos;, iso2)
vars.put(&apos;iso3&apos;, iso3)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
