              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def deviceTypes = [&apos;smartphone&apos;, &apos;tablet&apos;, &apos;desktop_pc&apos;, &apos;smart_tv&apos;, &apos;pos_terminal&apos;]
Random random =new Random();
def value = deviceTypes[random.nextInt(deviceTypes.size())]
vars.put(&quot;deviceTypes&quot;, value)

</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor-card" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">Random random = new Random()

def randomInt = { int min, int max -&gt; min + random.nextInt(max - min) }
def randomFrom = { List list -&gt; list[random.nextInt(list.size())] }
def randomBool = { double probability -&gt; random.nextDouble() &lt; probability }

// BIN Level
vars.put(&quot;bin_level&quot;, randomFrom([
    &quot;Low Risk BINs&quot;, &quot;Medium Risk BINs&quot;, &quot;High Risk BINs&quot;,
    &quot;Blacklisted BINs&quot;, &quot;Whitelisted BINs&quot;, &quot;Corporate BINs&quot;,
    &quot;Prepaid BINs&quot;, &quot;Debit BINs&quot;, &quot;Credit BINs&quot;,
    &quot;International BINs&quot;, &quot;Domestic BINs&quot;
]))

// Card Expiry
def card_expire = &quot;202${randomInt(4, 9)}-${String.valueOf(randomInt(1, 12)).padLeft(2, &apos;0&apos;)}&quot;
vars.put(&quot;card_expire&quot;, card_expire)

// AVS Result
vars.put(&quot;card_avs_result&quot;, randomFrom([&apos;Y&apos;, &apos;N&apos;, &apos;A&apos;, &apos;Z&apos;, &apos;U&apos;]))

// CVV Result — was storing the closure itself, now stores the value
vars.put(&quot;card_cvv_result&quot;, randomBool(0.9).toString())

// SCA Method
vars.put(&quot;card_sca_method&quot;, randomFrom([&apos;3DS&apos;, &apos;OTP&apos;, &apos;Biometric&apos;, &apos;None&apos;]))

// 3D Status
vars.put(&quot;card_status3d&quot;, randomFrom([&apos;authenticated&apos;, &apos;attempted&apos;, &apos;failed&apos;, &apos;not_enrolled&apos;]))</stringProp>
