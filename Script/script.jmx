            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor-userData" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Random

def random = new Random()

def genderList = [&quot;male&quot;, &quot;female&quot;]
def gender = genderList[random.nextInt(genderList.size())]

def familyStatusesList = [&apos;single&apos;, &apos;married&apos;, &apos;divorced&apos;, &apos;widowed&apos;, &apos;annulled&apos;]
def familyStatus = familyStatusesList[random.nextInt(familyStatusesList.size())]

def userAccountStatusList = [&apos;active&apos;, &apos;pending_kyc&apos;, &apos;restricted&apos;]
def userAccountStatus = userAccountStatusList[random.nextInt(userAccountStatusList.size())]

def userVerificationLevelList = [&apos;none&apos;, &apos;basic&apos;, &apos;verified&apos;]
def userVerificationLevel = userVerificationLevelList[random.nextInt(userVerificationLevelList.size())]

def userTypeList = [&apos;individual&apos;, &apos;corporate&apos;]
def userType = userTypeList[random.nextInt(userTypeList.size())]

// timestamp
long now = System.currentTimeMillis() / 1000
int min = 86400 * 30
int max = 86400 * 365
long randomOffset = min + (long)(Math.random() * (max - min))
long result = now - randomOffset

// store in JMeter vars
vars.put(&quot;userGender&quot;, gender)
vars.put(&quot;familyStatuses&quot;, familyStatus)
vars.put(&quot;user_account_status&quot;, userAccountStatus)
vars.put(&quot;user_verification_level&quot;, userVerificationLevel)
vars.put(&quot;randomTimestamp&quot;, result.toString())
vars.put(&quot;user_type&quot;, userType)</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor-device" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
