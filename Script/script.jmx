            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor-Transactions" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def actionType = vars.get(&quot;action_type&quot;)

def ranges = [
  &apos;money_transfer&apos;: [1000, 10000], &apos;withdrawal&apos;: [500, 5000],
    &apos;purchase&apos;: [10, 2000], &apos;deposit&apos;: [1000, 25000]
]


def range = ranges[actionType] ?: [10000, 5000000]

def min = range[0]
def max = range[1]

def amount

if (min == max) {
    amount = min.toString()
} else {
    amount = (new Random().nextInt(max - min + 1) + min).toString()
}


def tran_type=[&apos;debit&apos;, &apos;credit&apos;]
def type = tran_type[new Random().nextInt(tran_type.size())]

vars.put(&quot;transaction_amount&quot;, amount)
vars.put(&quot;tran_type&quot;, type)

def channel_website =[&apos;amazon.com&apos;, &apos;noon.com&apos;, &apos;apple.com&apos;, &apos;local-store.net&apos;]
def x = channel_website[new Random().nextInt(channel_website.size())]
vars.put(&quot;channel_website&quot;, x)

def old_changed_value =[&apos;pending&apos;, &apos;processing&apos;, &apos;null&apos;]
def old = old_changed_value[new Random().nextInt(old_changed_value.size())]
vars.put(&quot;old_changed_value&quot;, old)
def new_changed_value=[&apos;approved&apos;, &apos;declined&apos;, &apos;review&apos;]
def nex = new_changed_value[new Random().nextInt(new_changed_value.size())]
vars.put(&quot;new_changed_value&quot; , nex)

def auth_method=[&apos;2FA&apos;, &apos;password&apos;, &apos;biometric&apos;]
def auth=auth_method[new Random().nextInt(auth_method.size())]
vars.put(&quot;auth_method&quot;,auth)


</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
