            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor- get_emailDomainFromCSVfile" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def email = vars.get(&quot;user_email&quot;)
def emailDomain = &quot;&quot; 

if(email!= null){
	if(email.contains(&apos;@&apos;)){
		emailDomain=email.split(&apos;@&apos;)[1]
	}
}else {
        emailDomain=null 
	}
vars.put(&quot;Domain&quot;, emailDomain)</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor-suer the format of te big num " enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">String phone = vars.get(&quot;benef_phone&quot;)

// Remove scientific notation if present
if (phone.contains(&quot;E&quot;) || phone.contains(&quot;e&quot;)) {
    phone = new java.math.BigDecimal(phone).toPlainString()
}

// Remove any decimal point (e.g., 2.01012E11 → 201012000000)
phone = phone.replaceAll(&quot;\\.0*\$&quot;, &quot;&quot;)

vars.put(&quot;benef_phone&quot;, phone)

String benef_acct_num = vars.get(&quot;benef_acct_num&quot;)

// Remove scientific notation if present
if (benef_acct_num.contains(&quot;E&quot;) || benef_acct_num.contains(&quot;e&quot;)) {
    phone = new java.math.BigDecimal(benef_acct_num).toPlainString()
}

// Remove any decimal point (e.g., 2.01012E11 → 201012000000)
benef_acct_num = benef_acct_num.replaceAll(&quot;\\.0*\$&quot;, &quot;&quot;)

vars.put(&quot;benef_acct_num&quot;, benef_acct_num)</stringProp>
