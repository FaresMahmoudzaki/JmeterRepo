            <hashTree/>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor - getCountryName&amp;&amp;Code" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.Locale
import java.util.Random

def random = new Random()
def countryMap = [:]

// Names the API rejects - map them to accepted alternatives
def nameOverrides = [
    &apos;U.S. Virgin Islands&apos;     : &apos;United States Virgin Islands&apos;,
    &apos;U.S. Outlying Islands&apos;   : &apos;United States Outlying Islands&apos;,
    &apos;St. Martin&apos;              : &apos;Saint Martin&apos;,
    &apos;St. Barthélemy&apos;          : &apos;Saint Barthelemy&apos;,
    &apos;Côte d\&apos;Ivoire&apos;          : &apos;Cote Ivoire&apos;,
    &apos;Réunion&apos;                 : &apos;Reunion&apos;,
    &apos;São Tomé and Príncipe&apos;   : &apos;Sao Tome and Principe&apos;,
    &apos;Åland Islands&apos;           : &apos;Aland Islands&apos;,
]

for (code in Locale.getISOCountries()) {
    def locale = new Locale(&quot;&quot;, code)
    def rawName = locale.getDisplayCountry(Locale.ENGLISH)

    // Apply override if exists, otherwise use raw name
    def countryName = nameOverrides.containsKey(rawName) ? nameOverrides[rawName] : rawName

    // Validate against API&apos;s allowed pattern
    if (countryName ==~ /^[A-Za-z][A-Za-z .&apos;-]*[A-Za-z]$/) {
        countryMap[countryName] = [
            iso2: code,
            iso3: locale.getISO3Country()
        ]
    }
}

// Cities Map
def citiesMap = [
    &apos;United States&apos;              : [&apos;New York&apos;, &apos;Los Angeles&apos;],
    &apos;Egypt&apos;                      : [&apos;Cairo&apos;, &apos;Giza&apos;],
    &apos;United Arab Emirates&apos;       : [&apos;Dubai&apos;, &apos;Abu Dhabi&apos;],
    &apos;United States Virgin Islands&apos;: [&apos;Charlotte Amalie&apos;, &apos;Christiansted&apos;],
]

// Random country
def countries = countryMap.keySet().toList()
def randomCountry = countries[random.nextInt(countries.size())]

// Get ISO codes
def iso2 = countryMap[randomCountry].iso2
def iso3 = countryMap[randomCountry].iso3

// City
def cityList = citiesMap[randomCountry]
def randomCity = cityList ? cityList[random.nextInt(cityList.size())] : &quot;City&quot;

// Save variables
vars.put(&apos;country&apos;, randomCountry)
vars.put(&apos;iso2&apos;, iso2)
vars.put(&apos;iso3&apos;, iso3)
vars.put(&apos;ip_city&apos;, randomCity)</stringProp>
            </JSR223PreProcessor>
