              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def benef_acct_type = [&apos;checking&apos;, &apos;savings&apos;]
def value = benef_acct_type[new Random().nextInt(benef_acct_type.size())]

def benef_bank_type = [&apos;commercial&apos;, &apos;digital&apos;, &apos;investment&apos;]
def value1 = benef_bank_type[new Random().nextInt(benef_bank_type.size())]

def benef_entity_type = [&apos;individual&apos;, &apos;company&apos;]
def value2 = benef_entity_type[new Random().nextInt(benef_entity_type.size())]  // ← was missing )

vars.put(&quot;benef_acct_type&quot;, value)
vars.put(&quot;benef_bank_type&quot;, value1)
vars.put(&quot;benef_entity_type&quot;, value2)
</stringProp>
