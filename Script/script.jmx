            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor-transRefNumber" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.util.concurrent.atomic.AtomicLong

// global counter (shared بين كل threads)
if (props.get(&quot;counter&quot;) == null) {
    props.put(&quot;counter&quot;, new AtomicLong(System.currentTimeMillis()))
}

def counter = props.get(&quot;counter&quot;) as AtomicLong

// unique number
def uniqueNumber = counter.incrementAndGet()

vars.put(&quot;tran_ref_number&quot;, uniqueNumber.toString())</stringProp>
            </JSR223PreProcessor>
