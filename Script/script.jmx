              <stringProp name="script">def accountTypes = [&apos;joint_checking&apos;, &apos;money_market&apos;, &apos;brokerage&apos;, &apos;trust_fund&apos;] ; 
def value = accountTypes[new Random().nextInt(accountTypes.size())]
def userCategories = [&apos;premium_subscriber&apos;, &apos;merchant_account&apos;, &apos;system_admin&apos;, &apos;guest_user&apos;]
